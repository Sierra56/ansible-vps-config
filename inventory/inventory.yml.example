---
all:
  children:
    vps:
      hosts:
        name1:
          ansible_host: IP
          ansible_user: root
          ansible_ssh_private_key_file: /root/.ssh/ansible_key_private
        name2:
          ansible_host: IP
          ansible_user: root
          ansible_ssh_private_key_file: /root/.ssh/ansible_key_private
        name3:
          ansible_host: IP
          ansible_ssh_private_key_file: /root/.ssh/ansible_key_private
    test:
      hosts:
        testName:
          ansible_host: IP
          ansible_user: root
          ansible_password: "password"
          ansible_ssh_private_key_file: /root/.ssh/ansible_key_private
          ansible_ssh_port: 22
